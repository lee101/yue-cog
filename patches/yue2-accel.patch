+"""Exact weight placement: immutable CPU masters make offload free; pinning them speeds reload."""
+import torch
+
+_MASTER = "_yue2_master"
+
+
+def _master(tensor, pin):
+    master = getattr(tensor, _MASTER, None)
+    if master is None:
+        master = tensor.data
+    if pin and not master.is_pinned():
+        try:
+            master = master.pin_memory()
+        except RuntimeError:
+            pass
+    return master
+
+
+def place(module, device, pin=False):
+    """Move inference-only weights; values are byte-identical to Module.to()."""
+    device = torch.device(device)
+    for child in module.modules():
+        for store in (child._parameters, child._buffers):
+            for name, tensor in store.items():
+                if tensor is None or tensor.device == device:
+                    continue
+                if tensor.device.type == "cpu":
+                    master = _master(tensor, pin and device.type == "cuda")
+                    moved = master.to(device, non_blocking=master.is_pinned())
+                else:
+                    master = getattr(tensor, _MASTER, None)
+                    moved = master if master is not None and device.type == "cpu" else tensor.data.to(device)
+                    master = moved if device.type == "cpu" else master
+                if store is child._parameters:
+                    tensor.data = moved
+                    target = tensor
+                else:
+                    store[name] = target = moved
+                if master is not None and target is not master:
+                    setattr(target, _MASTER, master)
+    return module
